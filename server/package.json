{
  "name": "habitloop-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch index.ts",
    "start": "cross-env NODE_ENV=production tsx index.ts",
    "build": "tsc && vite build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "lint:fix": "eslint . --ext .ts --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "migrate": "tsx migrations/run-migrations.ts",
    "migrate:create": "tsx scripts/create-migration.ts",
    "migrate:status": "tsx scripts/migration-status.ts",
    "migrate:rollback": "tsx scripts/rollback-migration.ts",
    "db:verify": "tsx scripts/database/verify-current-schema.ts",
    "db:test": "tsx scripts/database/test-db-connection.ts",
    "db:checkmigrations": "tsx scripts/database/check-migrations.ts",
    "migration:record": "tsx scripts/migration/record-manual-migration.ts",
    "migration:cleanup": "tsx scripts/migration/cleanup-failed-migration.ts",
    "migration:history": "tsx scripts/migration/check-migration-records.ts"
  },
  "dependencies": {
    "@habitloop/shared": "file:../shared",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.10.9",
    "@types/socket.io": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.4",
    "drizzle-zod": "^0.5.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "googleapis": "^130.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.7",
    "openai": "^3.3.0",
    "pg": "^8.11.3",
    "socket.io": "^4.8.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "zod": "^3.25.76",
    "zod-validation-error": "^2.1.0"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/node": "^20.10.4",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "cross-env": "^10.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^8.54.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1"
  }
}
