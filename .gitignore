*.temp
*.bak
*.backup
*.swp
*.swo

# ========================================
# DATABASE & MIGRATION FILES (HIDE)
# ========================================

# Database files
migrations/
*.sql
server/schema-lock*.json
server/db.ts

# ========================================
# UNUSED & DEMO FILES (HIDE)
# ========================================

# Unused directories
notUsed/
demo/
server/demo/
-p/

# Demo and unused files
server/ml/ml_demo_working.py
server/syntheticDatabase.ts
server/supabaseAuth.ts

# ========================================
# CONFIGURATION FILES (HIDE SENSITIVE)
# ========================================

# Configuration files that might contain sensitive data
config-*.json
config-*.js
server/drizzle.config.ts
server/.eslintrc.cjs

# ========================================
# PRESERVE ESSENTIAL ML MODELS (KEEP)
# ========================================

# IMPORTANT: Keep these ML model files for supervisor
!server/ml/models/trained/metadata.json
!server/ml/models/trained/*.pkl
!server/ml/models/trained/*.joblib
!server/ml/models/habitPredictor.py

# ========================================
# PRESERVE CORE CODE (KEEP)
# ========================================

# Core application files
!server/routes/
!server/services/
!server/utils/
!server/ml/services/
!server/ml/pipelines/
!client/src/
!shared/

# Core configuration
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!tailwind.config.ts
!requirements.txt
!server/package.json
!server/tsconfig.json
!server/vite.ts

# Core documentation
!README.md
!docs/

# ========================================
# SYSTEM FILES (HIDE)
# ========================================

# OS files
.DS_Store
Thumbs.db

# Server artifacts
/server/server/

# Package directories
jspm_packages

# Serverless directories
.serverless

# FuseBox cache
.fusebox

# DynamoDB Local files
.dynamodb

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# Additional ignores
server/public
vite.config.ts.*
*.tar.gz

# ========================================
# DEVELOPMENT TOOLS (HIDE)
# ========================================

# Development tools and utilities
server/coachingEngine.ts
server/recommendationEngine.ts
server/openaiService.ts
server/emailService.ts

# ========================================
# NOTES FOR SUPERVISOR
# ========================================
# This repository contains:
# ✅ Core application code (client/, server/, shared/)
# ✅ ML models and services (server/ml/)
# ✅ Essential configuration files
# ✅ Main documentation (README.md, docs/)
# ❌ Development clutter, tests, and temporary files
# ❌ Sensitive configuration and environment files