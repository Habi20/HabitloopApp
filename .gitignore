/server/docs/

# Documentation files (development docs)
/README.md

# ========================================
# DEVELOPMENT ARTIFACTS (HIDE)
# ========================================

# Node modules
node_modules/
server/node_modules/
client/node_modules/

# Build outputs
/dist
/build
.next
out

# Environment files
.env
.env.local
.env.development
.env.test
.env.production
.env.*

